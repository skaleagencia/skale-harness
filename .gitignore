# --- credencial: nunca, em hipótese alguma ---
.env
.env.*
*.pem
*.key
.credentials.json
**/.credentials.json
claude/**/.env*
mcp-needs-auth-cache.json

# --- estado de sessão do Claude Code (não é configuração, é rastro de uso) ---
claude/projects/
claude/sessions/
claude/shell-snapshots/
claude/file-history/
claude/cache/
claude/session-env/
claude/plans/
claude/backups/
claude/history.jsonl
claude/statsig/
claude/ide/
claude/todos/

# --- instalado por gerenciador externo, não versionado (ver claude/MANIFEST.md) ---
claude/plugins/

# --- backups locais gerados pelo install.sh ---
backups-locais/
*.bak
*.bak-*

# --- sistema ---
.DS_Store
node_modules/
*.log

# Panorama do setup: levantamento local, nunca publicado.
# Lista caminho da máquina, plugins, MCPs e consumo — mapa de reconhecimento do ambiente.
PANORAMA.md

# --- exceção: a memória DESTE repositório precisa ser versionada ---
# O ~/.gitignore_global ignora .claude/ em todo lugar, e faz sentido: nos projetos de produto
# essa pasta é configuração de máquina. Aqui não — aqui ela guarda as lições de trabalho, que
# são justamente o que não pode se perder. As três linhas abaixo desfazem a regra global só
# para .claude/memory/, mantendo o resto de .claude/ fora (é estado de sessão).
!.claude/
.claude/*
!.claude/memory/
