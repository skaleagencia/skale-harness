{
  "permissions": {
    "_por_que_default_e_nao_bypass": [
      "bypassPermissions pareceria o caminho óbvio, e as duas exceções em ask continuariam valendo",
      "nele. Mas ele também desliga a proteção de caminhos críticos — .git, .claude, .zshrc,",
      ".npmrc, .mcp.json — que no modo default sempre pedem confirmação.",
      "Com allow cobrindo tudo, o efeito prático no dia a dia é o mesmo, e essa rede continua de pé."
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "/Users/ericsoarese/.claude",
      "/tmp",
      "/private/tmp",
      "/Users/ericsoarese/Desktop",
      "/Users/ericsoarese/Projetos Vibing Code/Cloude code/skale-insight",
      "/Users/ericsoarese/Projetos Vibing Code/Cloude code/Skale Finance Personal",
      "/Users/ericsoarese/Projetos Vibing Code/Cloude code/skale-clinic-performance",
      "/Users/ericsoarese/Projetos Vibing Code/Cloude code/LP Dr Bruno Sena"
    ],
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",
      "mcp__claude_ai_ClickUp",
      "mcp__obsidian",
      "mcp__context7",
      "mcp__claude_ai_Algrow",
      "mcp__chrome-devtools",
      "Bash(agent-browser:*)",
      "Bash(npx agent-browser:*)"
    ],
    "ask": [],
    "deny": []
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/registrar-comandos.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/avisar-destrutivo.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/checkpoint-automatico.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/rtk-proxy.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/secret-scan.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/graphify-orient.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/limite-despachos.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/lint-gate.mjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/validate-settings-schema.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/large-file-warning.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/format-on-edit.mjs",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/avisar-sql-nao-idempotente.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/ericsoarese/.claude/hooks/gh-scope-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/Users/ericsoarese/.claude/hooks/orchestration-mode.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/Users/ericsoarese/.claude/hooks/bootstrap-projeto.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
